# VaultAI configuration. Copy to .env and adjust. No secrets belong in this file.
# This is the recommended ASUS Ascent GX10 demo profile. The code's built-in
# mock backend remains available for deterministic tests; do not use it for the
# local-AI-track demo.

# --- Storage and server ---------------------------------------------------
VAULTAI_DATA_DIR=data                 # raw files, page images, exports, SQLite DB (owner-only perms)
VAULTAI_HOST=127.0.0.1                # desktop UI/API; loopback or private address only
VAULTAI_PORT=8765
VAULTAI_REVIEWER_NAME=local-user      # name recorded on approvals, edits, and exports

# --- Local model (never a cloud API) --------------------------------------
# mock = deterministic rules only, no LLM. openai_compat = a local OpenAI-
# compatible server such as the GX10's vLLM Nemotron server.
VAULTAI_MODEL_BACKEND=openai_compat
VAULTAI_MODEL_ENDPOINT=http://127.0.0.1:8000/v1   # must be loopback or private-network; public hosts are refused
VAULTAI_MODEL_NAME=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
VAULTAI_MODEL_API_KEY=                # only if your local server requires one
VAULTAI_MODEL_CONTEXT_TOKENS=8192
VAULTAI_MODEL_MAX_TOKENS=1024
VAULTAI_MODEL_TIMEOUT_S=180
VAULTAI_MODEL_TEMPERATURE=0
VAULTAI_MODEL_VISION=false            # Nemotron 3.5 Lightning is text-only; use local OCR
VAULTAI_MODEL_JSON_MODE=true          # false sends no response_format at all
VAULTAI_MODEL_RESPONSE_FORMAT=json_schema  # json_schema (vLLM structured output) | json_object | none
VAULTAI_MODEL_ENABLE_THINKING=false   # sent as chat_template_kwargs.enable_thinking; false makes Nemotron answer in content
VAULTAI_MODEL_SYSTEM_PREFIX=          # optional first line of the system prompt; not needed for Nemotron with thinking off
VAULTAI_MODEL_CONCURRENCY=2           # model requests in flight at once, across all documents
VAULTAI_MODEL_EXTRACT_CONTEXT_CHARS=2400   # document text per field-extraction request
VAULTAI_MODEL_ANALYSIS_CONTEXT_CHARS=12000 # document text per obligation/summary request

# --- OCR -------------------------------------------------------------------
VAULTAI_OCR_ENGINE=auto               # auto | tesseract | none
VAULTAI_TESSERACT_CMD=tesseract

# --- Input limits ----------------------------------------------------------
VAULTAI_MAX_FILE_MB=25
VAULTAI_MAX_PAGES=50
VAULTAI_MAX_IMAGE_PIXELS=40000000     # decompression-bomb ceiling per image/page
VAULTAI_MAX_BATCH_FILES=200
VAULTAI_REJECT_ACTIVE_PDF=true        # refuse PDFs with JavaScript, launch actions, embedded files, XFA
VAULTAI_PARSE_TIMEOUT_S=60            # per-document parser subprocess timeout
VAULTAI_PARSE_MEMORY_MB=1536          # parser subprocess address-space cap (Linux)
VAULTAI_WORKERS=2                     # documents processed concurrently

# --- Review policy ---------------------------------------------------------
VAULTAI_AUTO_APPROVE_TYPES=receipt    # comma list; empty disables auto-approval entirely
VAULTAI_AUTO_APPROVE_MIN_CONFIDENCE=0.9
VAULTAI_REVIEW_CONFIDENCE_THRESHOLD=0.75
VAULTAI_UNUSUAL_AMOUNT=10000
VAULTAI_DATE_ORDER=MDY                # how to read 03/04/2026: MDY or DMY

# --- Physical capture ------------------------------------------------------
VAULTAI_PHONE_ENABLED=false           # true opens a LAN-only listener for phone capture sessions
VAULTAI_PHONE_HOST=                   # LAN IP to put in the QR code; auto-detected when empty
VAULTAI_PHONE_PORT=8766
VAULTAI_PHONE_SESSION_TTL_S=600
VAULTAI_PHONE_MAX_PAGES=20
VAULTAI_PHONE_MAX_IMAGE_MB=12
VAULTAI_SCANNER_BACKEND=auto          # auto (SANE if present, else mock) | sane | mock | none

# --- Network ---------------------------------------------------------------
VAULTAI_EGRESS_GUARD=true             # block outbound connections to non-local addresses in-process
